{
  "name": "@goim/web-sdk",
  "version": "0.1.0",
  "description": "goim-sdk-core Web(wasm) 的浏览器薄封装",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "wasm"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "build:wasm": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-wasm.ps1"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
